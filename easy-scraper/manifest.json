{
  "manifest_version": 3,
  "name": "Easy Scraper",
  "version": "1.0.0",
  "description": "Extract tables, search results, and lists to CSV with one click.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
