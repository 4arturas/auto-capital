{
  "manifest_version": 3,
  "name": "Gmail Trimless",
  "version": "1.0.0",
  "description": "Automatically expands trimmed/clipped email content in Gmail.",
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
