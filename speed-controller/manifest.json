{
  "manifest_version": 3,
  "name": "Speed Controller",
  "version": "1.0.0",
  "description": "Valdykite HTML5 vaizdo įrašų atkūrimo greitį klaviatūros trumpiniais.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
